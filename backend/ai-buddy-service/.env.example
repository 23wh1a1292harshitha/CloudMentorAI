PORT=4000
JWT_SECRET=replace-with-a-long-random-string
TESTING_ENGINE_URL=http://localhost:4001

# --- AI Provider (pick one, priority: GROQ > OPENROUTER > GEMINI) ---

# Option 1: Groq — free tier, fast, recommended
# Get key at https://console.groq.com → API Keys
GROQ_API_KEY=

# Option 2: OpenRouter — free models available
# Get key at https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# Option 3: Gemini — requires billing on most projects
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
