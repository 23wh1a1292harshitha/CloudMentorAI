PORT=4001
# Must match JWT_SECRET in ai-buddy-service so the same login token works here.
JWT_SECRET=replace-with-a-long-random-string

# ── Optional: secure code execution sandbox for coding questions ──────────────
# When disabled (default), coding questions show full UI and accept submissions
# but are NOT executed — the API honestly reports "not configured" and awards
# 0 marks. Enable only with an isolated sandbox (Judge0, Docker, etc.).
# CODE_EXEC_ENABLED=true
# CODE_SANDBOX_URL=http://localhost:8080/execute
